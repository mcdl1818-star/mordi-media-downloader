TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# זמן בין סריקות. מומלץ 10 דקות; אפשר 60 כדי להפחית חסימות.
CHECK_INTERVAL_MINUTES=10
X_CHECK_INTERVAL_MINUTES=30
MAX_ITEMS_PER_SCAN=15

YT_DLP_PATH=yt-dlp
GALLERY_DL_PATH=gallery-dl
FFMPEG_PATH=ffmpeg
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPO=mcdl1818-star/mordi-media-downloader
GITHUB_ACTIONS_WORKFLOW=youtube-worker.yml
COBALT_API_URLS=

# link = התראה עם קישור (הכי אמין); video = ניסיון לשלוח גם את הקובץ.
SEND_MODE=video
MAX_FILE_SIZE_MB=49
DATA_DIR=./data
TEMP_DIR=./temp

# קובץ cookies.txt אופציונלי עבור חשבונות ציבוריים שהאתר חוסם בלי התחברות.
COOKIES_PATH=

# מצב ענן (Render)
PORT=10000
WEBHOOK_URL=
WEBHOOK_SECRET=
# Render free sleeps after 15 minutes without inbound traffic. The monitor pings
# its public health endpoint every 10 minutes by default so scheduled scans keep running.
CLOUD_KEEP_ALIVE=true
CLOUD_KEEP_ALIVE_MINUTES=10
HISTORY_COUNT=3
INSTAGRAM_LOGIN_USERNAME=vogelnati
